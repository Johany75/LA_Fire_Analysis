/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var studyArea = ee.FeatureCollection("projects/abujohani123/assets/Los_Angles_new");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var beforeStart = '2024-12-12';
var beforeEnd = '2025-01-05';

var duringStart = '2025-01-06';
var duringEnd = '2025-01-30';

var afterStart = '2025-01-31';
var afterEnd = '2025-02-10';


var no2Collection = ee.ImageCollection("COPERNICUS/S5P/NRTI/L3_NO2")
  .select('NO2_column_number_density')
  .filterBounds(studyArea);


function getDateList(startDate, endDate) {
  var start = ee.Date(startDate);
  var end = ee.Date(endDate);
  var dates = ee.List.sequence(0, end.difference(start, 'day').subtract(1))
    .map(function(day) {
      return start.advance(day, 'day').format('YYYY-MM-dd');
    });
  return dates;
}

function extractNO2Data(dates, period) {
  return dates.map(function(date) {
    var no2Image = no2Collection
      .filterDate(date, ee.Date(date).advance(1, 'day'))
      .mean()
      .clip(studyArea);

    var meanNO2 = no2Image.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: studyArea,
      scale: 1000,
      bestEffort: true
    }).get('NO2_column_number_density');

    return ee.Feature(null, {
      'Date': date,
      'Period': period,
      'Mean_NO2': meanNO2
    });
  });
}

var beforeDates = getDateList(beforeStart, beforeEnd);
var duringDates = getDateList(duringStart, duringEnd);
var afterDates = getDateList(afterStart, afterEnd);

var beforeData = extractNO2Data(beforeDates, 'Before');
var duringData = extractNO2Data(duringDates, 'During');
var afterData = extractNO2Data(afterDates, 'After');

var allNO2Data = ee.FeatureCollection(beforeData)
  .merge(ee.FeatureCollection(duringData))
  .merge(ee.FeatureCollection(afterData));

Export.table.toDrive({
  collection: allNO2Data,
  description: 'Daily_NO2_Analysis',
  fileFormat: 'CSV'
});
